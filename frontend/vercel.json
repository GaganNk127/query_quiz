{
  "version": 2,
  "name": "smartrecruit-ai",
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "env": {
    "VITE_API_URL": "@api-url",
    "VITE_EMAILJS_PUBLIC_KEY": "@emailjs-public-key",
    "VITE_EMAILJS_SERVICE_ID": "@emailjs-service-id",
    "VITE_EMAILJS_TEMPLATE_SHORTLIST": "@emailjs-template-shortlist",
    "VITE_EMAILJS_TEMPLATE_REJECTION": "@emailjs-template-rejection",
    "VITE_EMAILJS_TEMPLATE_QUIZ_ASSIGNED": "@emailjs-template-quiz-assigned",
    "VITE_APP_NAME": "SmartRecruit AI",
    "VITE_APP_VERSION": "1.0.0"
  },
  "build": {
    "env": {
      "VITE_API_URL": "@api-url",
      "VITE_EMAILJS_PUBLIC_KEY": "@emailjs-public-key",
      "VITE_EMAILJS_SERVICE_ID": "@emailjs-service-id",
      "VITE_EMAILJS_TEMPLATE_SHORTLIST": "@emailjs-template-shortlist",
      "VITE_EMAILJS_TEMPLATE_REJECTION": "@emailjs-template-rejection",
      "VITE_EMAILJS_TEMPLATE_QUIZ_ASSIGNED": "@emailjs-template-quiz-assigned"
    }
  },
  "functions": {},
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    },
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
